<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MiraiSpace.Presentation.Features.Documents"
             xmlns:documents="using:MiraiSpace.Application.Documents"
             xmlns:dialog="clr-namespace:DialogHostAvalonia;assembly=DialogHost.Avalonia"
             xmlns:behaviors="using:MiraiSpace.UI.Behaviors"
             x:Class="MiraiSpace.UI.Views.DocumentsPageView" x:DataType="vm:DocumentsPageViewModel">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="40" Spacing="24" MaxWidth="1050">
            <StackPanel Spacing="10">
                <TextBlock Text="YOUR WORKSPACE" Foreground="#34A58B" FontSize="11" FontWeight="Bold" LetterSpacing="2" />
                <TextBlock Text="Documents" Foreground="#222733" FontSize="34" FontWeight="SemiBold" />
                <TextBlock Text="A little room for what matters. Open a document and make it yours."
                           Foreground="#737B8C" FontSize="15" TextWrapping="Wrap" />
            </StackPanel>
            <TextBox Text="{Binding Search}" PlaceholderText="Find a document…" MinWidth="260" MaxWidth="480"
                     HorizontalAlignment="Left" Padding="14,10" />
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="documents:Document">
                        <Button Margin="0,0,0,12" Padding="24" Background="White" BorderBrush="#E3E6EC"
                                BorderThickness="1" CornerRadius="16" HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Command="{Binding $parent[UserControl].((vm:DocumentsPageViewModel)DataContext).OpenCommand}"
                                CommandParameter="{Binding}">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Border Background="#E5F4EE" CornerRadius="12" Padding="14" Margin="0,0,20,0">
                                    <TextBlock Text="▤" Foreground="#29876D" FontSize="24" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="19" FontWeight="SemiBold" Foreground="#252A36" />
                                    <TextBlock Text="{Binding Body}" MaxHeight="20" TextTrimming="CharacterEllipsis" Foreground="#737B8C" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="↗" FontSize="23" Margin="20,0,0,0" VerticalAlignment="Center" Foreground="#7165E8" />
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="No documents to show. Try another search."
                       IsVisible="{Binding HasNoDocuments}" Foreground="#737B8C" />
            <Border Background="#EDEAFB" CornerRadius="14" Padding="20">
                <StackPanel Spacing="6">
                    <TextBlock Text="Make a small change" FontWeight="SemiBold" Foreground="#5548AF" />
                    <TextBlock Text="Rename a document, edit a few lines, or try deleting one. These demo documents live for this session."
                               TextWrapping="Wrap" Foreground="#6F668E" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
