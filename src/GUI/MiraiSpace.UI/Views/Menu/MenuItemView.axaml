<rxui:ReactiveUserControl xmlns="https://github.com/avaloniaui"
                          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                          xmlns:rxui="using:ReactiveUI.Avalonia"
                          xmlns:menu="using:MiraiSpace.Presentation.Menu.Demo"
                          x:Class="MiraiSpace.UI.Views.Menu.MenuItemView"
                          x:TypeArguments="menu:MenuItemViewModel"
                          x:DataType="menu:MenuItemViewModel"
                          HorizontalContentAlignment="Stretch">
    <Grid ColumnDefinitions="4,40,*,Auto">
        <Border Width="3"
                Height="24"
                CornerRadius="2"
                Background="{Binding Accent}"
                IsVisible="{Binding IsSelected}" />
        <Border Grid.Column="1"
                Width="34"
                Height="34"
                CornerRadius="10"
                Background="{Binding Accent}">
            <TextBlock Text="{Binding Glyph}"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
        </Border>

        <StackPanel Grid.Column="2"
                    Margin="10,0,0,0"
                    VerticalAlignment="Center">
            <TextBlock Text="{Binding DisplayTitle}"
                       FontWeight="SemiBold"
                       Foreground="#343640" />
            <TextBlock Text="{Binding Caption}"
                       FontSize="9"
                       Foreground="#9295A1" />
        </StackPanel>

        <Border Grid.Column="3"
                IsVisible="{Binding HasBadge}"
                Background="{Binding Accent}"
                CornerRadius="10"
                Padding="7,2"
                VerticalAlignment="Center">
            <TextBlock Text="{Binding Badge}"
                       FontSize="10"
                       FontWeight="Bold"
                       Foreground="White" />
        </Border>
    </Grid>
</rxui:ReactiveUserControl>
