<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MiraiSpace.Presentation.ViewModels"
             mc:Ignorable="d"
             d:DesignWidth="1280"
             d:DesignHeight="820"
             x:Class="MiraiSpace.UI.Views.MainView"
             x:DataType="vm:MainViewModel">

    <Grid ColumnDefinitions="Auto,*"
          Background="#F3F5F9">
        <ContentControl Content="{Binding Menu}" />

        <Grid Grid.Column="1"
              RowDefinitions="64,*">
            <Border Background="#FCFCFD"
                    BorderBrush="#E4E7ED"
                    BorderThickness="0,0,0,1">
                <Grid Margin="28,0"
                      ColumnDefinitions="*,Auto"
                      VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center">
                        <TextBlock Text="MiraiSpace"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#252A36" />
                        <TextBlock Text="/"
                                   FontSize="11"
                                   Foreground="#B0B5C0" />
                        <TextBlock Text="Product workspace"
                                   FontSize="11"
                                   Foreground="#747B8B" />
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="10"
                                VerticalAlignment="Center">
                        <Button Width="36"
                                Height="36"
                                Padding="0"
                                Background="#F0F1F5"
                                BorderThickness="0"
                                CornerRadius="11"
                                ToolTip.Tip="Notifications">
                            <TextBlock Text="•"
                                       FontSize="18"
                                       Foreground="#6E63E8"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Button>
                        <Border Width="36"
                                Height="36"
                                Background="#252A36"
                                CornerRadius="11">
                            <TextBlock Text="AS"
                                       FontSize="9"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <ContentControl Grid.Row="1"
                            Content="{Binding Navigation.CurrentPage}" />
        </Grid>
    </Grid>
</UserControl>
