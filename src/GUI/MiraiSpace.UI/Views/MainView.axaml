<rxui:ReactiveUserControl xmlns="https://github.com/avaloniaui"
                          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                          xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                          xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                          xmlns:vm="using:MiraiSpace.Presentation.ViewModels"
                          xmlns:mxtl="https://schemas.eremexcontrols.net/avalonia/treelist"
                          xmlns:menuViews="using:MiraiSpace.UI.Views.Menu"
                          xmlns:rxui="using:ReactiveUI.Avalonia"
                          mc:Ignorable="d"
                          d:DesignWidth="1280"
                          d:DesignHeight="820"
                          x:Class="MiraiSpace.UI.Views.MainView"
                          x:TypeArguments="vm:MainViewModel"
                          x:DataType="vm:MainViewModel">
    <rxui:ReactiveUserControl.Resources>
        <menuViews:AppMenuChildrenSelector x:Key="AppMenuChildrenSelector" />
    </rxui:ReactiveUserControl.Resources>

    <SplitView IsPaneOpen="{Binding IsMenuOpen}"
               DisplayMode="CompactInline"
               CompactPaneLength="128"
               OpenPaneLength="304">
        <SplitView.Pane>
            <Border Margin="12" Background="White" BorderBrush="#E8E7EF" BorderThickness="1"
                    CornerRadius="22" BoxShadow="0 12 34 0 #120D1028">
                <Grid RowDefinitions="88,Auto,*,Auto">
                    <Grid Margin="16,16,12,12" ColumnDefinitions="44,*">
                        <Button Width="42" Height="42" Padding="0" CornerRadius="13"
                                Background="#6D5DD3" BorderThickness="0"
                                Command="{Binding ToggleMenuCommand}">
                            <TextBlock Text="M" FontSize="19" FontWeight="Bold" Foreground="White" />
                        </Button>
                        <StackPanel Grid.Column="1" Margin="11,2,0,0"
                                    IsVisible="{Binding IsMenuOpen}">
                            <TextBlock Text="MIRAI SPACE" FontSize="13" FontWeight="Bold"
                                       Foreground="#252630" LetterSpacing="0.5" />
                            <TextBlock Text="Architecture lab" FontSize="11" Foreground="#999CA8" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Grid.Row="1" Margin="22,4,0,8" Text="NAVIGATION"
                               IsVisible="{Binding IsMenuOpen}" FontSize="9" FontWeight="Bold"
                               Foreground="#A5A7B2" LetterSpacing="1.4" />

                    <mxtl:TreeListControl Grid.Row="2"
                                         Margin="6,0,6,8"
                                         ItemsSource="{Binding Items}"
                                         ChildrenSelector="{StaticResource AppMenuChildrenSelector}"
                                         AutoGenerateColumns="False"
                                         ShowColumnHeaders="False"
                                         ShowHorizontalLines="False"
                                         ShowVerticalLines="False">
                        <mxtl:TreeListControl.Columns>
                            <mxtl:TreeListColumn FieldName="DisplayTitle" Width="*">
                                <mxtl:TreeListColumn.CellTemplate>
                                    <DataTemplate x:CompileBindings="False">
                                        <ContentControl Content="{Binding Row}" />
                                    </DataTemplate>
                                </mxtl:TreeListColumn.CellTemplate>
                            </mxtl:TreeListColumn>
                        </mxtl:TreeListControl.Columns>
                    </mxtl:TreeListControl>

                    <Border Grid.Row="3" Margin="10" Padding="10" CornerRadius="14" Background="#F5F3FC">
                        <Grid ColumnDefinitions="34,*">
                            <Border Width="32" Height="32" CornerRadius="10" Background="#252630">
                                <TextBlock Text="AS" FontSize="9" FontWeight="Bold" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center"
                                        IsVisible="{Binding IsMenuOpen}">
                                <TextBlock Text="Alex Stone" FontSize="11" FontWeight="SemiBold" />
                                <TextBlock Text="Local session" FontSize="9" Foreground="#9295A1" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </SplitView.Pane>

        <Grid RowDefinitions="74,*" Background="#F8F8FB">
            <Border BorderBrush="#E7E8EE" BorderThickness="0,0,0,1">
                <Grid Margin="32,0" ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                    <Button Width="34" Height="34" Padding="0" CornerRadius="11"
                            Background="White" BorderBrush="#E3E4EA"
                            Command="{Binding ToggleMenuCommand}">
                        <TextBlock Text="☰" Foreground="#777A86" />
                    </Button>
                    <TextBlock Grid.Column="1" Margin="12,0,0,0" Text="Team workspace"
                               FontSize="12" FontWeight="SemiBold" Foreground="#777A86" />
                    <Border Grid.Column="2" Background="#EAE8FA" CornerRadius="18" Padding="13,7">
                        <TextBlock Text="●  Connected" FontSize="10" FontWeight="SemiBold" Foreground="#5E54C7" />
                    </Border>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1">
                <StackPanel Margin="52,46" MaxWidth="900" HorizontalAlignment="Stretch">
                    <Border Width="42" Height="5" CornerRadius="3" Background="{Binding Navigation.Accent}"
                            HorizontalAlignment="Left" Margin="0,0,0,22" />
                    <TextBlock Text="{Binding Navigation.Eyebrow}" FontSize="10" FontWeight="Bold"
                               Foreground="{Binding Navigation.Accent}" LetterSpacing="1.8" />
                    <TextBlock Text="{Binding Navigation.Title}" FontSize="38" FontWeight="SemiBold"
                               Foreground="#22232C" Margin="0,8,0,8" />
                    <TextBlock Text="{Binding Navigation.Description}" FontSize="15" Foreground="#7A7D89"
                               MaxWidth="620" HorizontalAlignment="Left" TextWrapping="Wrap" />

                    <Grid Margin="0,42,0,0" ColumnDefinitions="2*,*,*">
                        <Border Margin="0,0,14,0" Padding="24" CornerRadius="18" Background="White"
                                BorderBrush="#E8E9EF" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="WEEKLY MOMENTUM" FontSize="9" FontWeight="Bold" Foreground="#9A9DA8" />
                                <TextBlock Text="84%" FontSize="34" FontWeight="Bold" Foreground="#272832" Margin="0,18,0,6" />
                                <ProgressBar Value="84" Height="8" Foreground="#7165E8" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Margin="0,0,14,0" Padding="22" CornerRadius="18" Background="#22232C">
                            <StackPanel>
                                <TextBlock Text="ACTIVE PAGES" FontSize="9" FontWeight="Bold" Foreground="#AEB0BA" />
                                <TextBlock Text="24" FontSize="34" FontWeight="Bold" Foreground="White" Margin="0,18,0,3" />
                                <TextBlock Text="6 updated today" FontSize="10" Foreground="#A8E4D3" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Padding="22" CornerRadius="18" Background="#EEEAFD">
                            <StackPanel>
                                <TextBlock Text="DELEGATES" FontSize="9" FontWeight="Bold" Foreground="#7770A1" />
                                <TextBlock Text="2" FontSize="34" FontWeight="Bold" Foreground="#5E54C7" Margin="0,18,0,3" />
                                <TextBlock Text="Spaces shared with you" FontSize="10" Foreground="#7770A1" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </SplitView>
</rxui:ReactiveUserControl>
