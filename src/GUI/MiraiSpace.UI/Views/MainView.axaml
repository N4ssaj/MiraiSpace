<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i="using:Avalonia.Xaml.Interactivity"
             xmlns:dock="https://schemas.eremexcontrols.net/avalonia/docking"
             xmlns:vm="using:MiraiSpace.Presentation.ViewModels"
             xmlns:panels="using:MiraiSpace.Presentation.Panels"
             xmlns:views="using:MiraiSpace.UI.Views"
             xmlns:behaviors="using:MiraiSpace.UI.Behaviors"
             x:Class="MiraiSpace.UI.Views.MainView" x:DataType="vm:MainViewModel">
    <UserControl.KeyBindings>
        <KeyBinding Gesture="Ctrl+OemTilde" Command="{Binding Console.ToggleCommand}" />
    </UserControl.KeyBindings>
    <Grid ColumnDefinitions="Auto,*" Background="#F3F5F9">
        <ContentControl Content="{Binding Menu}" />
        <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*,Auto">
            <Border Padding="20,10" Background="#FCFCFD" BorderBrush="#E4E7ED" BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="MiraiSpace" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="Command console" Command="{Binding Console.ToggleCommand}" />
                </Grid>
            </Border>
            <TextBlock Grid.Row="1" Text="{Binding Errors.Message}" Foreground="#BE4255"
                       TextWrapping="Wrap" Margin="20,4" />
            <dock:DockManager Grid.Row="2" ItemsSource="{Binding Panels.Panels}" BorderThickness="0">
                <i:Interaction.Behaviors>
                    <behaviors:FloatingPanelsBehavior />
                </i:Interaction.Behaviors>
                <dock:DockManager.ItemTemplate>
                    <DataTemplate DataType="panels:NavigationPanelViewModel">
                        <dock:DocumentPane Header="{Binding Title}" CloseCommand="{Binding CloseCommand}"
                                           AllowAutoHide="False" AllowFloat="True" />
                    </DataTemplate>
                </dock:DockManager.ItemTemplate>
                <dock:DockManager.ItemContentTemplate>
                    <DataTemplate DataType="panels:NavigationPanelViewModel">
                        <views:NavigationPanelView ViewModel="{Binding}" />
                    </DataTemplate>
                </dock:DockManager.ItemContentTemplate>
                <dock:DockGroup>
                    <dock:DocumentGroup>
                        <dock:DocumentPane Header="Workspace" AllowClose="False" AllowFloat="False" AllowAutoHide="False">
                            <views:NavigationPanelView ViewModel="{Binding MainPanel}" />
                        </dock:DocumentPane>
                    </dock:DocumentGroup>
                </dock:DockGroup>
            </dock:DockManager>
            <ContentControl Grid.Row="3" Content="{Binding Console}" IsVisible="{Binding Console.IsOpen}" />
        </Grid>
    </Grid>
</UserControl>
