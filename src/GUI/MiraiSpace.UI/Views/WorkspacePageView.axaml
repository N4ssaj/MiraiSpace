<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:navigation="using:MiraiSpace.Presentation.Features.Workspace.Navigation"
             mc:Ignorable="d"
             d:DesignWidth="980"
             d:DesignHeight="756"
             x:Class="MiraiSpace.UI.Views.WorkspacePageView"
             x:DataType="navigation:WorkspacePageViewModel">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="36,34,36,46"
                    MaxWidth="1100"
                    HorizontalAlignment="Stretch">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                    <TextBlock Text="{Binding Eyebrow}"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="{Binding Accent}"
                               LetterSpacing="1.6" />
                    <TextBlock Text="{Binding Title}"
                               Margin="0,8,0,7"
                               FontSize="32"
                               FontWeight="SemiBold"
                               Foreground="#222733" />
                    <TextBlock Text="{Binding Description}"
                               MaxWidth="660"
                               FontSize="13"
                               Foreground="#737B8C"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Left" />
                </StackPanel>

                <Button Grid.Column="1"
                        Margin="24,7,0,0"
                        Padding="17,10"
                        Background="{Binding Accent}"
                        BorderThickness="0"
                        CornerRadius="11"
                        Foreground="White"
                        VerticalAlignment="Top">
                    <TextBlock Text="＋  Create"
                               FontSize="11"
                               FontWeight="SemiBold" />
                </Button>
            </Grid>

            <Grid Margin="0,30,0,0"
                  ColumnDefinitions="*,*,*">
                <Border Margin="0,0,8,0"
                        Padding="20"
                        Background="White"
                        BorderBrush="#E3E6EC"
                        BorderThickness="1"
                        CornerRadius="16">
                    <Grid RowDefinitions="Auto,Auto,Auto">
                        <TextBlock Text="WEEKLY MOMENTUM"
                                   FontSize="9"
                                   FontWeight="Bold"
                                   Foreground="#858C9B"
                                   LetterSpacing="1" />
                        <Grid Grid.Row="1"
                              Margin="0,14,0,12"
                              ColumnDefinitions="*,Auto">
                            <TextBlock Text="84%"
                                       FontSize="28"
                                       FontWeight="Bold"
                                       Foreground="#252A36" />
                            <Border Grid.Column="1"
                                    Padding="8,4"
                                    Background="#E7F7F1"
                                    CornerRadius="9"
                                    VerticalAlignment="Center">
                                <TextBlock Text="+12%"
                                           FontSize="9"
                                           FontWeight="Bold"
                                           Foreground="#278568" />
                            </Border>
                        </Grid>
                        <ProgressBar Grid.Row="2"
                                     Height="6"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="84"
                                     Foreground="#47AD8D"
                                     Background="#E8EFED" />
                    </Grid>
                </Border>

                <Border Grid.Column="1"
                        Margin="4,0"
                        Padding="20"
                        Background="White"
                        BorderBrush="#E3E6EC"
                        BorderThickness="1"
                        CornerRadius="16">
                    <StackPanel>
                        <TextBlock Text="ACTIVE PAGES"
                                   FontSize="9"
                                   FontWeight="Bold"
                                   Foreground="#858C9B"
                                   LetterSpacing="1" />
                        <TextBlock Margin="0,14,0,5"
                                   Text="24"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="#252A36" />
                        <TextBlock Text="6 updated today"
                                   FontSize="10"
                                   Foreground="#858C9B" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2"
                        Margin="8,0,0,0"
                        Padding="20"
                        Background="#252A36"
                        CornerRadius="16">
                    <StackPanel>
                        <TextBlock Text="TEAM FOCUS"
                                   FontSize="9"
                                   FontWeight="Bold"
                                   Foreground="#AEB5C4"
                                   LetterSpacing="1" />
                        <TextBlock Margin="0,14,0,5"
                                   Text="3 goals"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="White" />
                        <TextBlock Text="On track this sprint"
                                   FontSize="10"
                                   Foreground="#959EAF" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Margin="0,16,0,0"
                  ColumnDefinitions="1.65*,*">
                <Border Margin="0,0,8,0"
                        Padding="22"
                        Background="White"
                        BorderBrush="#E3E6EC"
                        BorderThickness="1"
                        CornerRadius="16">
                    <StackPanel>
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel>
                                <TextBlock Text="Current sprint"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="#292E3A" />
                                <TextBlock Text="September 1 — September 14"
                                           Margin="0,4,0,0"
                                           FontSize="10"
                                           Foreground="#8A91A1" />
                            </StackPanel>
                            <Border Grid.Column="1"
                                    Padding="10,5"
                                    Background="#F0EEFD"
                                    CornerRadius="9"
                                    VerticalAlignment="Center">
                                <TextBlock Text="18 / 24 tasks"
                                           FontSize="9"
                                           FontWeight="SemiBold"
                                           Foreground="#675BD1" />
                            </Border>
                        </Grid>

                        <ProgressBar Margin="0,22,0,20"
                                     Height="7"
                                     Minimum="0"
                                     Maximum="24"
                                     Value="18"
                                     Foreground="{Binding Accent}"
                                     Background="#ECEAF8" />

                        <Grid ColumnDefinitions="*,*,*">
                            <StackPanel>
                                <TextBlock Text="12"
                                           FontSize="19"
                                           FontWeight="Bold"
                                           Foreground="#2A2E3A" />
                                <TextBlock Text="Completed"
                                           FontSize="9"
                                           Foreground="#8A91A1" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="6"
                                           FontSize="19"
                                           FontWeight="Bold"
                                           Foreground="#2A2E3A" />
                                <TextBlock Text="In progress"
                                           FontSize="9"
                                           Foreground="#8A91A1" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="3"
                                           FontSize="19"
                                           FontWeight="Bold"
                                           Foreground="#2A2E3A" />
                                <TextBlock Text="Contributors"
                                           FontSize="9"
                                           Foreground="#8A91A1" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1"
                        Margin="8,0,0,0"
                        Padding="22"
                        Background="White"
                        BorderBrush="#E3E6EC"
                        BorderThickness="1"
                        CornerRadius="16">
                    <StackPanel>
                        <TextBlock Text="Recent activity"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#292E3A" />

                        <Grid Margin="0,19,0,0"
                              ColumnDefinitions="34,*">
                            <Border Width="32"
                                    Height="32"
                                    Background="#E7F5F0"
                                    CornerRadius="10">
                                <TextBlock Text="MC"
                                           FontSize="8"
                                           FontWeight="Bold"
                                           Foreground="#2E8D71"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1"
                                        Margin="9,0,0,0">
                                <TextBlock Text="Maya updated Roadmap"
                                           FontSize="10"
                                           Foreground="#3B404D" />
                                <TextBlock Text="12 minutes ago"
                                           Margin="0,2,0,0"
                                           FontSize="8"
                                           Foreground="#979DAB" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,15,0,0"
                              ColumnDefinitions="34,*">
                            <Border Width="32"
                                    Height="32"
                                    Background="#EEEAFE"
                                    CornerRadius="10">
                                <TextBlock Text="NW"
                                           FontSize="8"
                                           FontWeight="Bold"
                                           Foreground="#6657D5"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1"
                                        Margin="9,0,0,0">
                                <TextBlock Text="Noah shared a page"
                                           FontSize="10"
                                           Foreground="#3B404D" />
                                <TextBlock Text="46 minutes ago"
                                           Margin="0,2,0,0"
                                           FontSize="8"
                                           Foreground="#979DAB" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
