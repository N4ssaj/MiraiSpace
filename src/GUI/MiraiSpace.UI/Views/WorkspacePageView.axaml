<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MiraiSpace.Presentation.Features.Workspace.Navigation"
             x:Class="MiraiSpace.UI.Views.WorkspacePageView" x:DataType="vm:WorkspacePageViewModel">
    <UserControl.Styles>
        <Style Selector="Button.destination">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="22" />
            <Setter Property="MinHeight" Value="112" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E3E6EC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
        </Style>
    </UserControl.Styles>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="40,40,40,48" Spacing="28" MaxWidth="1000">
            <StackPanel Spacing="12">
                <TextBlock Text="{Binding Eyebrow}" Foreground="{Binding Accent}" FontSize="11" FontWeight="Bold" LetterSpacing="2" />
                <TextBlock Text="{Binding Title}" Foreground="#222733" FontSize="34" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Description}" Foreground="#737B8C" FontSize="15" TextWrapping="Wrap" MaxWidth="680" HorizontalAlignment="Left" />
            </StackPanel>
            <Border Background="#252A36" CornerRadius="20" Padding="28">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="8" Margin="0,0,24,0">
                        <TextBlock Text="A home for your next idea" FontSize="21" FontWeight="SemiBold" Foreground="White" />
                        <TextBlock Text="Open a document and make it your own." FontSize="13" Foreground="#ADB5C5" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Explore documents  →" Command="{Binding OpenPagesCommand}" Background="{Binding Accent}"
                            Foreground="White" Padding="18,12" CornerRadius="12" VerticalAlignment="Center" />
                </Grid>
            </Border>
            <TextBlock Text="PICK UP WHERE YOU NEED TO" Foreground="#848B99" FontSize="11" FontWeight="Bold" LetterSpacing="1.2" />
            <Grid ColumnDefinitions="*,*,*">
                <Button Classes="destination" Command="{Binding OpenPagesCommand}" Margin="0,0,8,0">
                    <StackPanel Spacing="8"><TextBlock Text="▤  Pages" FontSize="17" Foreground="#252A36" /><TextBlock Text="Ideas worth keeping" FontSize="12" Foreground="#737B8C" /></StackPanel>
                </Button>
                <Button Grid.Column="1" Classes="destination" Command="{Binding OpenInboxCommand}" Margin="4,0">
                    <StackPanel Spacing="8"><TextBlock Text="✉  Inbox" FontSize="17" Foreground="#252A36" /><TextBlock Text="Stay in the loop" FontSize="12" Foreground="#737B8C" /></StackPanel>
                </Button>
                <Button Grid.Column="2" Classes="destination" Command="{Binding OpenCalendarCommand}" Margin="8,0,0,0">
                    <StackPanel Spacing="8"><TextBlock Text="□  Calendar" FontSize="17" Foreground="#252A36" /><TextBlock Text="See what is ahead" FontSize="12" Foreground="#737B8C" /></StackPanel>
                </Button>
            </Grid>
            <Border BorderBrush="#DFE3EB" BorderThickness="0,1,0,0" Padding="0,24,0,0">
                <TextBlock Text="Tip: press Ctrl+K to find a destination. Alt+← takes you back." Foreground="#858C9B" FontSize="12" TextWrapping="Wrap" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
